{
	"name": "@sondr3/minitest",
	"version": "0.1.2",
	"description": "A low-feature, dependency-free and performant test runner inspired by Rust and Deno",
	"keywords": [
		"ava",
		"fast",
		"jest",
		"runner",
		"tap",
		"tape",
		"tdd",
		"test",
		"testing",
		"unit",
		"uvu"
	],
	"homepage": "https://github.com/sondr3/minitest#readme",
	"bugs": {
		"url": "https://github.com/sondr3/minitest/issues"
	},
	"license": "MIT",
	"author": "Sondre Aasemoen <sondre@eons.io> (https://www.eons.io)",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/sondr3/minitest.git"
	},
	"bin": {
		"mt": "bin/mt.mjs"
	},
	"files": [
		"bin/**/*",
		"dist/**/*.js",
		"dist/**/*.d.ts",
		"dist/**/*.map",
		"!dist/**/*.test.*",
		"!dist/tests",
		"lib/**/*.ts",
		"!lib/**/*.test.ts",
		"!lib/tests",
		"*.md"
	],
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "tsc --watch --incremental",
		"build": "tsc",
		"test": "c8 node bin/mt.mjs dist",
		"format": "oxfmt",
		"lint": "oxlint --fix",
		"check": "oxfmt --check && oxlint"
	},
	"devDependencies": {
		"@sondr3/oxfmt": "0.1.2",
		"@sondr3/oxlint": "0.1.1",
		"@sondr3/tsconfig": "0.10.0",
		"@types/node": "26.6.6",
		"c8": "12.0.0",
		"oxfmt": "0.76.0",
		"oxlint": "1.91.0",
		"oxlint-tsgolint": "7.0.2005",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@12.16.1"
}
