{
	"extends": [
		"@sondr3/tsconfig/tsconfig.base.json",
		"@sondr3/tsconfig/tsconfig.lib.json",
		"@sondr3/tsconfig/tsconfig.node.json"
	],
	"compilerOptions": {
		"allowJs": true,
		"isolatedDeclarations": false,
		"stripInternal": true,
		"rootDir": "lib",
		"outDir": "dist",
		"tsBuildInfoFile": "node_modules/.cache/tsconfig.tsbuildinfo"
	},
	"include": ["lib"],
	"exclude": ["coverage", "node_modules", "dist"]
}
